{
  "name": "bkm-varredura-sjc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Varredura noturna dos lotes de São José dos Campos no GeoSanja",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-strip-types --test test/*.test.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --external:@supabase/supabase-js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.6.2"
  }
}
