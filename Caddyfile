(geosanja) {
	reverse_proxy https://geo.sjc.sp.gov.br {
		header_up Host {upstream_hostport}
		header_up -Origin
		header_up -Referer
		header_up -Cookie
		header_down -Set-Cookie
		header_down -Access-Control-Allow-Origin
	}
}

# O Cloud Run define $PORT (8080).
:{$PORT:8080} {
	encode zstd gzip

	# Protótipo navegável. A chave única do Google (restrita ao domínio no Cloud
	# Console) vem da variável GOOGLE_MAPS_KEY e é injetada na página (templates).
	handle /prototipo* {
		root * /srv/prototipo
		uri strip_prefix /prototipo
		header Cache-Control "no-cache"
		templates {
			mime text/html
			between {% %}
		}
		try_files {path} /index.html
		file_server
	}

	# GeoSampa (Prefeitura de São Paulo): o servidor de camadas só aceita chamada de
	# navegador vinda do próprio Novo GeoSampa, então a ficha consulta por aqui.
	# Só GET nos serviços públicos de camadas (WFS/WMS); nada de cookie nem origem.
	handle_path /geosampa/* {
		@camadas {
			method GET
			path /geoserver/geoportal/ows /geoserver/geoportal/wms
		}
		handle @camadas {
			reverse_proxy https://geoserver.geosampa.prefeitura.sp.gov.br {
				header_up Host {upstream_hostport}
				header_up -Origin
				header_up -Referer
				header_up -Cookie
				header_down -Set-Cookie
				header_down -Access-Control-Allow-Origin
			}
		}
		# Folhas do laser 2020 (MDT 1:1000, .laz) para o topográfico preliminar: o
		# download do Novo GeoSampa, só a camada de articulação do MDT 2020 (id 125).
		@mdt {
			method GET
			path /Download/File/125
		}
		handle @mdt {
			reverse_proxy https://novogeosampa.prefeitura.sp.gov.br {
				header_up Host {upstream_hostport}
				header_up -Origin
				header_up -Referer
				header_up -Cookie
				header_down -Set-Cookie
				header_down -Access-Control-Allow-Origin
			}
		}
		respond 404
	}

	# GeoSanja (Prefeitura de São José dos Campos): a API do próprio site, sem
	# CORS. Só o que a ficha usa: token de visitante, busca pela inscrição e o
	# repasse de camadas (WMS); nada de cookie nem origem.
	handle_path /geosanja/* {
		@visitante {
			method GET
			path /v1/autenticar /v1/proxy
		}
		@busca {
			method POST
			path /v1/localizar
		}
		handle @visitante {
			import geosanja
		}
		handle @busca {
			import geosanja
		}
		respond 404
	}

	# Enquanto o banco não existe, a raiz leva ao protótipo. O app React fica em /app.
	handle / {
		redir * /prototipo/ 302
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
