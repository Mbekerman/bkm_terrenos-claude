(geosanja) {
	reverse_proxy https://geo.sjc.sp.gov.br {
		header_up Host {upstream_hostport}
		header_up -Origin
		header_up -Referer
		header_up -Cookie
		header_down -Set-Cookie
		header_down -Access-Control-Allow-Origin
	}
}

# O Cloud Run define $PORT (8080).
:{$PORT:8080} {
	encode zstd gzip

	# Protótipo navegável. A chave única do Google (restrita ao domínio no Cloud
	# Console) vem da variável GOOGLE_MAPS_KEY e é injetada na página (templates).
	handle /prototipo* {
		root * /srv/prototipo
		uri strip_prefix /prototipo
		header Cache-Control "no-cache"
		templates {
			mime text/html
			between {% %}
		}
		try_files {path} /index.html
		file_server
	}

	# GeoSampa (Prefeitura de São Paulo): o servidor de camadas só aceita chamada de
	# navegador vinda do próprio Novo GeoSampa, então a ficha consulta por aqui.
	# Só GET nos serviços públicos de camadas (WFS/WMS); nada de cookie nem origem.
	handle_path /geosampa/* {
		@camadas {
			method GET
			path /geoserver/geoportal/ows /geoserver/geoportal/wms
		}
		handle @camadas {
			reverse_proxy https://geoserver.geosampa.prefeitura.sp.gov.br {
				header_up Host {upstream_hostport}
				header_up -Origin
				header_up -Referer
				header_up -Cookie
				header_down -Set-Cookie
				header_down -Access-Control-Allow-Origin
			}
		}
		# Folhas do laser 2020 (MDT 1:1000, .laz) para o topográfico preliminar: o
		# download do Novo GeoSampa, só a camada de articulação do MDT 2020 (id 125).
		@mdt {
			method GET
			path /Download/File/125
		}
		handle @mdt {
			reverse_proxy https://novogeosampa.prefeitura.sp.gov.br {
				header_up Host {upstream_hostport}
				header_up -Origin
				header_up -Referer
				header_up -Cookie
				header_down -Set-Cookie
				header_down -Access-Control-Allow-Origin
			}
		}
		respond 404
	}

	# GeoSanja (Prefeitura de São José dos Campos): a API do próprio site, sem
	# CORS. Só o que a ficha usa: token de visitante, busca pela inscrição e o
	# repasse de camadas (WMS); nada de cookie nem origem.
	handle_path /geosanja/* {
		@visitante {
			method GET
			path /v1/autenticar /v1/proxy /v1/inscricao/bycoord
		}
		@busca {
			method POST
			path /v1/localizar
		}
		handle @visitante {
			import geosanja
		}
		handle @busca {
			import geosanja
		}
		respond 404
	}

	# IPTU de São Paulo (9/nov/2026): o serviço terrenos-iptu do Cloud Run (services/iptu)
	# emite a notificação de lançamento no portal da Prefeitura com a Senha Web guardada no
	# Secret Manager dele e grava o venal e o IPTU com o login de quem pediu. Só as rotas
	# do serviço; sem IPTU_URL no serviço, responde 502.
	handle /iptu/* {
		@iptu {
			method POST GET
			path /iptu/consultar /iptu/notificacao /iptu/fila /iptu/situacao /iptu/saude
		}
		handle @iptu {
			reverse_proxy {$IPTU_URL:http://127.0.0.1:9} {
				header_up Host {upstream_hostport}
				header_up -Cookie
				header_down -Set-Cookie
				transport http {
					response_header_timeout 180s
				}
			}
		}
		respond 404
	}

	# Sem banco configurado no serviço (SUPABASE_URL vazia, como na produção até o primeiro
	# uso), a raiz leva ao protótipo. Com o banco, a raiz abre o sistema real.
	@sem_banco expression `{env.SUPABASE_URL} == ""`
	handle / {
		redir @sem_banco /prototipo/ 302
		root * /srv
		header Cache-Control "no-cache"
		templates {
			mime text/html
			between {% %}
		}
		rewrite * /index.html
		file_server
	}

	# App React. A página (index.html) recebe o endereço e a chave publicável do Supabase e o
	# ambiente pelas variáveis SUPABASE_URL, SUPABASE_KEY e AMBIENTE do serviço (templates).
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@pagina not path /assets/*
		header @pagina Cache-Control "no-cache"
		# Arquivo de /assets que não existe (hash de uma versão anterior, pedido por
		# página aberta antes da publicação) é 404, nunca o index.html: senão o
		# navegador recebe HTML no lugar do script e o erro fica confuso. O front
		# recarrega a página uma vez nesse caso (lib/versaoNova.ts).
		@assetFaltando {
			path /assets/*
			not file
		}
		respond @assetFaltando 404
		templates {
			mime text/html
			between {% %}
		}
		try_files {path} /index.html
		file_server
	}
}
