# Só para o `npm run dev`. No Cloud Run os valores vêm das variáveis do serviço
# (SUPABASE_URL, SUPABASE_KEY, AMBIENTE), postas na página pelo Caddy.
# Supabase → Project Settings → API: URL e chave publicável (sb_publishable_...)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
VITE_AMBIENTE=dev
# chave do Google Maps (restrita por domínio; localhost precisa estar liberado na chave)
VITE_GMAPS_KEY=
